<script>

/* SAVE DATA */

function saveItem(key,item){

    const a =
        JSON.parse(
            localStorage.getItem(key) || "[]"
        );

    a.push(item);

    localStorage.setItem(
        key,
        JSON.stringify(a)
    );

}


/* SECURITY FOR NEWS */

function escapeHtml(v){

    return String(v ?? "")
        .replace(
            /[&<>"']/g,
            m => ({
                "&":"&amp;",
                "<":"&lt;",
                ">":"&gt;",
                "\"":"&quot;",
                "'":"&#039;"
            }[m])
        );

}


/* APPLICATION FORM */

document
.getElementById("applicationForm")
.addEventListener(
    "submit",
    function(e){

        e.preventDefault();

        const s =
            document.getElementById(
                "applicationStatus"
            );

        saveItem(
            "ipss_applications",
            {
                studentName:
                    document.getElementById(
                        "studentName"
                    ).value,

                dateOfBirth:
                    document.getElementById(
                        "dateOfBirth"
                    ).value,

                gender:
                    document.getElementById(
                        "gender"
                    ).value,

                classApplying:
                    document.getElementById(
                        "classApplying"
                    ).value,

                previousSchool:
                    document.getElementById(
                        "previousSchool"
                    ).value,

                guardianName:
                    document.getElementById(
                        "guardianName"
                    ).value,

                guardianPhone:
                    document.getElementById(
                        "guardianPhone"
                    ).value,

                email:
                    document.getElementById(
                        "email"
                    ).value,

                additionalInformation:
                    document.getElementById(
                        "additionalInformation"
                    ).value,

                status:"New",

                submittedAt:
                    new Date().toLocaleString()
            }
        );

        s.textContent =
            "✅ Application submitted successfully!";

        this.reset();

    }
);


/* CONTACT FORM */

document
.getElementById("messageForm")
.addEventListener(
    "submit",
    function(e){

        e.preventDefault();

        const s =
            document.getElementById(
                "messageStatus"
            );

        saveItem(
            "ipss_messages",
            {
                name:
                    document.getElementById(
                        "messageName"
                    ).value,

                email:
                    document.getElementById(
                        "messageEmail"
                    ).value,

                phone:
                    document.getElementById(
                        "messagePhone"
                    ).value,

                message:
                    document.getElementById(
                        "messageText"
                    ).value,

                status:"New",

                sentAt:
                    new Date().toLocaleString()
            }
        );

        s.textContent =
            "✅ Message sent successfully!";

        this.reset();

    }
);


/* LOAD NEWS FROM DASHBOARD */

function loadNews(){

    const box =
        document.getElementById(
            "publicNews"
        );

    const items =
        JSON.parse(
            localStorage.getItem(
                "ipss_news"
            ) || "[]"
        );

    if(!items.length){

        box.innerHTML =
            '<p style="text-align:center">' +
            'No announcements yet.' +
            '</p>';

        return;
    }

    box.innerHTML =
        items
        .slice()
        .reverse()
        .map(
            n => `
            <article class="news-card">

                <h3>
                    ${escapeHtml(n.title)}
                </h3>

                <p>
                    ${escapeHtml(n.body)}
                </p>

                <div class="date">
                    ${escapeHtml(
                        n.date ||
                        n.createdAt ||
                        ""
                    )}
                </div>

            </article>
            `
        )
        .join("");

}

loadNews();

</script>

